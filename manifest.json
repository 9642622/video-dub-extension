{
  "manifest_version": 3,
  "name": "Перевод видео",
  "version": "0.4.5",
  "description": "Перевод и русская озвучка видео из хранилища: ElevenLabs — расшифровка, OpenAI — перевод, Fish Audio — голоса",
  "permissions": [
    "tabCapture",
    "offscreen",
    "storage",
    "activeTab",
    "declarativeNetRequest",
    "scripting"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "yandex",
        "enabled": true,
        "path": "yandex-rules.json"
      }
    ]
  },
  "host_permissions": [
    "https://api.browser.yandex.ru/*",
    "https://*.mds.yandex.net/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.openai.com/*",
    "https://api.fish.audio/*",
    "https://cloud.frame-house.eu/*",
    "https://api.elevenlabs.io/*",
    "https://gist.githubusercontent.com/*",
    "https://*.supabase.co/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "tracking.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "pcm.js",
        "chunker-worklet.js",
        "pipeline.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}